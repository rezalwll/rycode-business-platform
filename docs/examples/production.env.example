# Copy outside the repository as .env.production and chmod 0600.
# Never commit real values.

RYCODE_DOMAIN=example.com
CADDYFILE_PATH=./Caddyfile.prod
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=rycode
POSTGRES_DB=rycode
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_APP_URL=https://example.com

AUTH_EMAIL_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=RYCODE <no-reply@example.com>
