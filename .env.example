# Public application URL. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (Docker Compose defaults shown for local development only).
DATABASE_URL=postgresql://rycode:rycode_dev_only@localhost:5432/rycode?schema=public

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Local development may log verification/reset links to the terminal. Production
# must use smtp; disabled also disables public email/password registration.
AUTH_EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RYCODE <no-reply@example.com>

# Required in production. Docker Compose provides the internal service name.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Private storage lives outside the public directory.
PRIVATE_STORAGE_ROOT=./storage/private

# Optional initial administrator bootstrap. The seed refuses weak passwords.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
