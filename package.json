{
  "name": "rycode",
  "version": "0.1.0",
  "private": true,
  "description": "RYCODE production website, customer workspace, CMS and business platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "predev": "pnpm db:generate",
    "dev": "next dev --turbopack",
    "prebuild": "pnpm db:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "pnpm db:generate",
    "test": "vitest run",
    "pretest:integration": "pnpm db:generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "pretest:coverage": "pnpm db:generate",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.3",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "better-auth": "1.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.575.0",
    "next": "16.3.4",
    "nodemailer": "10.0.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "postcss": "8.5.6",
    "prettier": "3.9.6",
    "prisma": "7.8.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
