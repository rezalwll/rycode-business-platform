  anonymousIdHash String       @map("anonymous_id_hash") @db.Char(64)
  consent         ConsentState @default(UNKNOWN)
  locale          String?      @db.VarChar(10)
  landingPath     String?      @map("landing_path")
  referrer        String?
  utmSource       String?      @map("utm_source") @db.VarChar(255)
  utmMedium       String?      @map("utm_medium") @db.VarChar(255)
  utmCampaign     String?      @map("utm_campaign") @db.VarChar(255)
  ipHash          String?      @map("ip_hash") @db.Char(64)
  userAgentHash   String?      @map("user_agent_hash") @db.Char(64)
  firstSeenAt     DateTime     @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events AnalyticsEvent[]
  leads  Lead[]

  @@index([anonymousIdHash, firstSeenAt])
  @@index([userId, firstSeenAt])
  @@index([lastSeenAt])
  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id         BigInt             @id @default(autoincrement())
  sessionId  String             @map("session_id") @db.Uuid
  userId     String?            @map("user_id")
  name       AnalyticsEventName
  customName String?            @map("custom_name") @db.VarChar(120)
  path       String?
  pageType   AnalyticsPageType? @map("page_type")
  entityType String?            @map("entity_type") @db.VarChar(80)
  entityId   String?            @map("entity_id") @db.VarChar(128)
  label      String?            @db.VarChar(240)
  value      Decimal?           @db.Decimal(18, 4)
  metadata   Json?              @db.JsonB
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("analytics_events")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id")
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.VarChar(128)
  requestId   String?  @map("request_id") @db.Uuid
  before      Json?    @map("before_data") @db.JsonB
  after       Json?    @map("after_data") @db.JsonB
  metadata    Json?    @db.JsonB
  ipHash      String?  @map("ip_hash") @db.Char(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}
