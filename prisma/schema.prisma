generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientKind {
  INDIVIDUAL   @map("individual")
  ORGANIZATION @map("organization")

  @@map("client_kind")
}

enum ClientMemberRole {
  OWNER   @map("owner")
  ADMIN   @map("admin")
  MEMBER  @map("member")
  BILLING @map("billing")
  VIEWER  @map("viewer")

  @@map("client_member_role")
}

enum LeadType {
  CONTACT      @map("contact")
  CONSULTATION @map("consultation")
  QUOTE        @map("quote")
  AUDIT        @map("audit")
  SUPPORT      @map("support")

  @@map("lead_type")
}

enum LeadStatus {
  NEW       @map("new")
  QUALIFIED @map("qualified")
  CONTACTED @map("contacted")
  PROPOSAL  @map("proposal")
  WON       @map("won")
  LOST      @map("lost")
  SPAM      @map("spam")
  ARCHIVED  @map("archived")

  @@map("lead_status")
}

enum LeadActivityType {
  CREATED         @map("created")
  STATUS_CHANGED  @map("status_changed")
  NOTE_ADDED      @map("note_added")
  CONTACT_ATTEMPT @map("contact_attempt")
  ASSIGNED        @map("assigned")
  CONVERTED       @map("converted")
  FILE_ATTACHED   @map("file_attached")

  @@map("lead_activity_type")
}

enum ProjectStatus {
  DRAFT     @map("draft")
  PLANNED   @map("planned")
  ACTIVE    @map("active")
  ON_HOLD   @map("on_hold")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
  ARCHIVED  @map("archived")

  @@map("project_status")
}

enum ProjectMemberRole {
  OWNER           @map("owner")
  MANAGER         @map("manager")
  CONTRIBUTOR     @map("contributor")
  CLIENT_APPROVER @map("client_approver")
  CLIENT_VIEWER   @map("client_viewer")

  @@map("project_member_role")
}

enum MilestoneKind {
  DISCOVERY   @map("discovery")
  DESIGN      @map("design")
  DEVELOPMENT @map("development")
  REVIEW      @map("review")
  DELIVERY    @map("delivery")
  CUSTOM      @map("custom")

  @@map("milestone_kind")
}

enum MilestoneStatus {
  PENDING           @map("pending")
  IN_PROGRESS       @map("in_progress")
  AWAITING_APPROVAL @map("awaiting_approval")
  CHANGES_REQUESTED @map("changes_requested")
  APPROVED          @map("approved")
  COMPLETED         @map("completed")
  BLOCKED           @map("blocked")
  CANCELLED         @map("cancelled")

  @@map("milestone_status")
}

enum MilestoneApprovalDecision {
  APPROVED          @map("approved")
  REJECTED          @map("rejected")
  CHANGES_REQUESTED @map("changes_requested")

  @@map("milestone_approval_decision")
}

enum ActivityVisibility {
  INTERNAL @map("internal")
  CLIENT   @map("client")

  @@map("activity_visibility")
}

enum FileStorageProvider {
  LOCAL @map("local")
  S3    @map("s3")

  @@map("file_storage_provider")
}

enum FileCategory {
  GENERAL           @map("general")
  LEAD_ATTACHMENT   @map("lead_attachment")
  PROJECT_ASSET     @map("project_asset")
  TICKET_ATTACHMENT @map("ticket_attachment")
  INVOICE_DOCUMENT  @map("invoice_document")
  PAYMENT_RECEIPT   @map("payment_receipt")
  CMS_MEDIA         @map("cms_media")

  @@map("file_category")
}

enum FileStatus {
  UPLOADING   @map("uploading")
  QUARANTINED @map("quarantined")
  READY       @map("ready")
  REJECTED    @map("rejected")
  DELETED     @map("deleted")

  @@map("file_status")
}

enum FileScanStatus {
  PENDING  @map("pending")
  CLEAN    @map("clean")
  INFECTED @map("infected")
  FAILED   @map("failed")

  @@map("file_scan_status")
}

enum FileVisibility {
  INTERNAL        @map("internal")
  PROJECT_MEMBERS @map("project_members")
  CLIENT_MEMBERS  @map("client_members")

  @@map("file_visibility")
}

enum TicketStatus {
  OPEN              @map("open")
  WAITING_ON_STAFF  @map("waiting_on_staff")
  WAITING_ON_CLIENT @map("waiting_on_client")
  RESOLVED          @map("resolved")
  CLOSED            @map("closed")

  @@map("ticket_status")
}

enum TicketCategory {
  GENERAL   @map("general")
  TECHNICAL @map("technical")
  BILLING   @map("billing")
  PROJECT   @map("project")

  @@map("ticket_category")
}

enum TicketPriority {
  LOW    @map("low")
  NORMAL @map("normal")
  HIGH   @map("high")
  URGENT @map("urgent")

  @@map("ticket_priority")
}

enum TicketMessageVisibility {
  PUBLIC   @map("public")
  INTERNAL @map("internal")

  @@map("ticket_message_visibility")
}

enum InvoiceStatus {
  DRAFT          @map("draft")
  ISSUED         @map("issued")
  PARTIALLY_PAID @map("partially_paid")
  PAID           @map("paid")
  OVERDUE        @map("overdue")
  VOID           @map("void")

  @@map("invoice_status")
}

enum InstallmentStatus {
  PENDING        @map("pending")
  PARTIALLY_PAID @map("partially_paid")
  PAID           @map("paid")
  OVERDUE        @map("overdue")
  WAIVED         @map("waived")

  @@map("installment_status")
}

enum PaymentStatus {
  PENDING   @map("pending")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  REFUNDED  @map("refunded")
  VOID      @map("void")

  @@map("payment_status")
}

enum PaymentMethod {
  BANK_TRANSFER @map("bank_transfer")
  CARD          @map("card")
  CASH          @map("cash")
  CHEQUE        @map("cheque")
  GATEWAY       @map("gateway")
  OTHER         @map("other")

  @@map("payment_method")
}

enum NotificationKind {
  SYSTEM    @map("system")
  PROJECT   @map("project")
  MILESTONE @map("milestone")
  TICKET    @map("ticket")
  INVOICE   @map("invoice")
  PAYMENT   @map("payment")
  CONTENT   @map("content")

  @@map("notification_kind")
}

enum ContentKind {
  ARTICLE     @map("article")
  SERVICE     @map("service")
  SOLUTION    @map("solution")
  PROBLEM     @map("problem")
  INDUSTRY    @map("industry")
  INTEGRATION @map("integration")
  CASE_STUDY  @map("case_study")

  @@map("content_kind")
}

enum ContentStatus {
  DRAFT     @map("draft")
  REVIEW    @map("review")
  SCHEDULED @map("scheduled")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("content_status")
}

enum TranslationState {
  DRAFT    @map("draft")
  REVIEWED @map("reviewed")
  APPROVED @map("approved")

  @@map("translation_state")
}

enum ContentRelationKind {
  RELATED       @map("related")
  SOLVES        @map("solves")
  USES          @map("uses")
  FOR_INDUSTRY  @map("for_industry")
  CASE_STUDY_OF @map("case_study_of")

  @@map("content_relation_kind")
}

enum AuthorRole {
  PRIMARY     @map("primary")
  COAUTHOR    @map("coauthor")
  CONTRIBUTOR @map("contributor")
  REVIEWER    @map("reviewer")

  @@map("author_role")
}

enum SiteSettingVisibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
  SECRET  @map("secret")

  @@map("site_setting_visibility")
}

enum ConsentState {
  UNKNOWN @map("unknown")
  GRANTED @map("granted")
  DENIED  @map("denied")

  @@map("consent_state")
}

enum AnalyticsEventName {
  PAGE_VIEW      @map("page_view")
  CTA_CLICK      @map("cta_click")
  FORM_STARTED   @map("form_started")
  FORM_SUBMITTED @map("form_submitted")
  SEARCH         @map("search")
  DOWNLOAD       @map("download")
  LOGIN          @map("login")
  CUSTOM         @map("custom")

  @@map("analytics_event_name")
}

enum AnalyticsPageType {
  MARKETING @map("marketing")
  ARTICLE   @map("article")
  SERVICE   @map("service")
  PORTAL    @map("portal")
  ADMIN     @map("admin")
  OTHER     @map("other")

  @@map("analytics_page_type")
}

model User {
  id            String   @id
  name          String   @db.VarChar(160)
  email         String   @unique @db.VarChar(320)
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  roles               UserRole[]          @relation("UserRoleUser")
  assignedRoles       UserRole[]          @relation("UserRoleAssignedBy")
  clientMemberships   ClientMember[]
  submittedLeads      Lead[]              @relation("LeadSubmittedBy")
  ownedLeads          Lead[]              @relation("LeadOwner")
  leadActivities      LeadActivity[]
  projectMemberships  ProjectMember[]
  milestoneApprovals  MilestoneApproval[]
  projectActivities   ProjectActivity[]
  uploadedFiles       FileAsset[]
  openedTickets       Ticket[]            @relation("TicketOpenedBy")
  assignedTickets     Ticket[]            @relation("TicketAssignedTo")
  ticketMessages      TicketMessage[]
  recordedPayments    Payment[]
  notifications       Notification[]
  createdContentItems ContentItem[]       @relation("ContentCreatedBy")
  updatedContentItems ContentItem[]       @relation("ContentUpdatedBy")
  authorProfile       Author?             @relation("AuthorUser")
  updatedSiteSettings SiteSetting[]
  analyticsSessions   AnalyticsSession[]
  analyticsEvents     AnalyticsEvent[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model Profile {
  userId      String   @id @map("user_id")
  displayName String?  @map("display_name") @db.VarChar(160)
  phone       String?  @db.VarChar(32)
  company     String?  @db.VarChar(200)
  locale      String   @default("fa") @db.VarChar(10)
  timezone    String   @default("Asia/Tehran") @db.VarChar(64)
  bio         String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id")
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id")
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Client {
  id             String     @id @default(uuid()) @db.Uuid
  kind           ClientKind @default(ORGANIZATION)
  displayName    String     @map("display_name") @db.VarChar(200)
  legalName      String?    @map("legal_name") @db.VarChar(240)
  email          String?    @db.VarChar(320)
  phone          String?    @db.VarChar(32)
  taxId          String?    @map("tax_id") @db.VarChar(64)
  billingAddress Json?      @map("billing_address") @db.JsonB
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime?  @map("archived_at") @db.Timestamptz(3)

  members  ClientMember[]
  leads    Lead[]
  projects Project[]
  tickets  Ticket[]
  invoices Invoice[]
  payments Payment[]

  @@index([displayName])
  @@index([isActive, archivedAt])
  @@map("clients")
}

model ClientMember {
  clientId  String           @map("client_id") @db.Uuid
  userId    String           @map("user_id")
  role      ClientMemberRole @default(MEMBER)
  isPrimary Boolean          @default(false) @map("is_primary")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
  @@index([userId])
  @@index([clientId, role])
  @@map("client_members")
}

model Lead {
  id                 String     @id @default(uuid()) @db.Uuid
  clientId           String?    @map("client_id") @db.Uuid
  analyticsSessionId String?    @map("analytics_session_id") @db.Uuid
  submittedById      String?    @map("submitted_by_id")
  ownerId            String?    @map("owner_id")
  type               LeadType   @default(CONTACT)
  status             LeadStatus @default(NEW)
  name               String     @db.VarChar(160)
  company            String?    @db.VarChar(200)
  email              String?    @db.VarChar(320)
  phone              String?    @db.VarChar(32)
  source             String?    @db.VarChar(120)
  landingPath        String?    @map("landing_path")
  service            String?    @db.VarChar(160)
  problem            String?    @db.VarChar(160)
  industry           String?    @db.VarChar(160)
  budget             String?    @db.VarChar(120)
  summary            String?
  formPayload        Json?      @map("form_payload") @db.JsonB
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?  @map("archived_at") @db.Timestamptz(3)

  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  analyticsSession AnalyticsSession? @relation(fields: [analyticsSessionId], references: [id], onDelete: SetNull)
  submittedBy      User?             @relation("LeadSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  owner            User?             @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities       LeadActivity[]
  files            LeadFile[]
  convertedProject Project?

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([clientId])
  @@index([analyticsSessionId])
  @@index([ownerId, status])
  @@index([email])
  @@map("leads")
}

model LeadActivity {
  id         String           @id @default(uuid()) @db.Uuid
  leadId     String           @map("lead_id") @db.Uuid
  actorId    String?          @map("actor_id")
  type       LeadActivityType
  fromStatus LeadStatus?      @map("from_status")
  toStatus   LeadStatus?      @map("to_status")
  note       String?
  metadata   Json?            @db.JsonB
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([actorId, createdAt])
  @@map("lead_activities")
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  originLeadId    String?       @unique @map("origin_lead_id") @db.Uuid
  number          String        @unique @db.VarChar(48)
  slug            String?       @unique @db.VarChar(180)
  name            String        @db.VarChar(220)
  scope           String?
  status          ProjectStatus @default(DRAFT)
  progress        Int           @default(0)
  startDate       DateTime?     @map("start_date") @db.Date
  expectedEndDate DateTime?     @map("expected_end_date") @db.Date
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)
  latestUpdate    String?       @map("latest_update")
  clientAction    String?       @map("client_action")
  internalNote    String?       @map("internal_note")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(3)

  client     Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  originLead Lead?             @relation(fields: [originLeadId], references: [id], onDelete: SetNull)
  members    ProjectMember[]
  milestones Milestone[]
  activities ProjectActivity[]
  files      ProjectFile[]
  tickets    Ticket[]
  invoices   Invoice[]

  @@index([clientId, status])
  @@index([status, updatedAt])
  @@index([archivedAt])
  @@map("projects")
}

model ProjectMember {
  projectId      String            @map("project_id") @db.Uuid
  userId         String            @map("user_id")
  role           ProjectMemberRole @default(CONTRIBUTOR)
  canViewFinance Boolean           @default(false) @map("can_view_finance")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_members")
}

model Milestone {
  id               String          @id @default(uuid()) @db.Uuid
  projectId        String          @map("project_id") @db.Uuid
  kind             MilestoneKind   @default(CUSTOM)
  title            String          @db.VarChar(220)
  description      String?
  status           MilestoneStatus @default(PENDING)
  position         Int
  progress         Int             @default(0)
  startDate        DateTime?       @map("start_date") @db.Date
  expectedEndDate  DateTime?       @map("expected_end_date") @db.Date
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(3)
  deliverables     Json?           @db.JsonB
  approvalRequired Boolean         @default(false) @map("approval_required")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvals MilestoneApproval[]

  @@unique([projectId, position])
  @@index([projectId, status])
  @@map("milestones")
}

model MilestoneApproval {
  id          String                    @id @default(uuid()) @db.Uuid
  milestoneId String                    @map("milestone_id") @db.Uuid
  userId      String                    @map("user_id")
  decision    MilestoneApprovalDecision
  note        String?
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([milestoneId, createdAt])
  @@index([userId, createdAt])
  @@map("milestone_approvals")
}

model ProjectActivity {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @map("project_id") @db.Uuid
  actorId     String?            @map("actor_id")
  type        String             @db.VarChar(80)
  description String
  visibility  ActivityVisibility @default(CLIENT)
  metadata    Json?              @db.JsonB
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, visibility, createdAt])
  @@index([actorId, createdAt])
  @@map("project_activities")
}

model FileAsset {
  id              String              @id @default(uuid()) @db.Uuid
  storageProvider FileStorageProvider @default(LOCAL) @map("storage_provider")
  bucket          String              @default("private") @db.VarChar(100)
  objectKey       String              @unique @map("object_key")
  originalName    String              @map("original_name")
  mimeType        String              @map("mime_type") @db.VarChar(255)
  sizeBytes       BigInt              @map("size_bytes")
  checksumSha256  String?             @map("checksum_sha256") @db.Char(64)
  category        FileCategory        @default(GENERAL)
  status          FileStatus          @default(UPLOADING)
  scanStatus      FileScanStatus      @default(PENDING) @map("scan_status")
  uploadedById    String?             @map("uploaded_by_id")
  readyAt         DateTime?           @map("ready_at") @db.Timestamptz(3)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
