{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/content/**/*.ts",
    "src/db/**/*.ts",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/i18n/**/*.ts",
    "src/lib/**/*.ts",
    "src/server/**/*.ts",
    "src/server/**/*.tsx",
    "src/proxy.ts",
    "prisma.config.ts",
    "prisma/seed.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.ts",
    "playwright.config.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/components/workspace/**",
    "src/components/site/collection.tsx",
    "src/components/site/kind-pages.tsx",
    "src/components/site/lead-form.tsx",
    "src/components/site/lead-wizard.tsx",
    "src/components/ui/**",
    "src/hooks/use-auth.ts",
    "src/integrations/**",
    "src/lib/i18n.ts",
    "src/lib/public-content.ts",
    "src/lib/workspace/**",
    "src/routeTree.gen.ts",
    "src/router.tsx",
    "src/routes/**",
    "src/server.ts",
    "src/start.ts",
    "vite.config.ts"
  ]
}
