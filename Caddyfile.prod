{
	admin off
	servers {
		protocols h1 h2 h3
	}
}

www.{$RYCODE_DOMAIN:rycode.ir} {
	redir https://{$RYCODE_DOMAIN:rycode.ir}{uri} permanent
}

{$RYCODE_DOMAIN:rycode.ir} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	request_body {
		max_size 22MB
	}

	reverse_proxy app:3000 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}
